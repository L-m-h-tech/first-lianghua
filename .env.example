# 复制为 .env 后填写；.env 已在 .gitignore、绝不入库/入日志。真实系统环境变量优先于本文件。
# 告警 Webhook（飞书/钉钉/企业微信/Server酱/通用JSON），留空=不推送
FUTURES_MONITOR_WEBHOOK=
# Webhook 类型：auto / feishu / dingtalk / wecom / serverchan / generic
# FUTURES_MONITOR_WEBHOOK_TYPE 如需可在 config.json 配 ALERT_WEBHOOK_TYPE
# 声音告警：设为 0 静音（默认响）
FUTURES_MONITOR_SOUND=1
# 可选：外置配置文件路径（默认读项目根 config.json）
# FUTURES_MONITOR_CONFIG=C:/path/to/config.json
# 可选：外置 .env 路径（默认项目根 .env）
# FUTURES_MONITOR_ENV=C:/path/to/.env
# G13 预留：LLM 第二意见（无 key 完全休眠，永不改分下单）
# FUTURES_MONITOR_LLM_KEY=
# FUTURES_MONITOR_LLM_BASE_URL=
# FUTURES_MONITOR_LLM_MODEL=
# G18 预留：Tushare Pro token（零依赖裸 HTTP，无 token 等价现状）
# TUSHARE_TOKEN=
